function statOf(arr){
  if(!arr||!arr.length)return{x:0,y:0,z:0,t:9.8,pt:9.8};
  let x=0,y=0,z=0,tt=0,pt=0;arr.forEach(s=>{x+=s.x;y+=s.y;z+=s.z;tt+=s.t;pt=Math.max(pt,s.t)});
  const n=arr.length;return{x:x/n,y:y/n,z:z/n,t:tt/n,pt};
}
function calibFinish(){
  const still=statOf(calibData.still),left=statOf(calibData.left),right=statOf(calibData.right),jump=statOf(calibData.jump),custom=statOf(calibData.custom);
  Motion.base={x:still.x,y:still.y,z:still.z,t:still.t||9.8};
  const base=Motion.base,diff={x:Math.abs(left.x-right.x),y:Math.abs(left.y-right.y),z:Math.abs(left.z-right.z)};
  let stepAxis='x';if(diff.y>diff[stepAxis])stepAxis='y';if(diff.z>diff[stepAxis])stepAxis='z';
  const lv=left[stepAxis]-base[stepAxis],rv=right[stepAxis]-base[stepAxis];
  const stepTh=Math.max(.6,(Math.abs(lv)+Math.abs(rv))/2*.6);
  const jumpDelta=Math.max(.5,(jump.pt||base.t)-base.t);   // peak, not mean: a jump is a brief spike
  const jumpTh=Math.max(3,jumpDelta*.5);
  const axes=['x','y','z'].filter(a=>a!==stepAxis);
  let customAxis=axes[0],bestDiff=-1;
  axes.forEach(a=>{const d=Math.abs(custom[a]-base[a]);if(d>bestDiff){bestDiff=d;customAxis=a}});
  const customTh=Math.max(.6,bestDiff*.6);
  Object.assign(Motion.settings,{stepAxis,customAxis,stepTh:+stepTh.toFixed(2),jumpTh:+jumpTh.toFixed(2),customTh:+customTh.toFixed(2),calibrated:true});
  Motion.save();
  S='settings';syncSettingsUI();show('settings');
}
