const CalibSteps=['still','left','right','jump','custom'];
const CalibNames={still:'Step 1 of 5: hold the phone normally and stand still',left:'Step 2 of 5: side-step LEFT',right:'Step 3 of 5: side-step RIGHT',jump:'Step 4 of 5: jump',custom:'Step 5 of 5: perform your own movement'};
let calibIdx=0,calibData={};
function calibShowStep(){
  $('calibStep').textContent=CalibNames[CalibSteps[calibIdx]];
  $('calibHint').textContent='Get ready, then press Record.';
  $('calibBar').firstElementChild.style.width='0%';
  $('calibRec').disabled=false;
