    $('zbar').style.display='';const b=$('zbar').children;b[0].style.flex=p(below);b[1].style.flex=p(inZ);b[2].style.flex=p(above);
  }
  if(mode!=='zone')$('zbar').style.display='none';
  statsArr.push(['Peak HR',Math.round(hrPeak)+' bpm']);
  $('rt').textContent=mode==='reaction'?reactScore+' pts':fmt(raceT);
  $('rbest').textContent='';
  $('rz').textContent=zlabel;
  $('verdict').textContent=verdict;
  $('stats').innerHTML=statsArr.map(a=>`<div><b>${a[1]}</b><span>${a[0]}</span></div>`).join('');
  $('preScore').textContent=score;
  pendingResult={n,zlabel,score,shareBase,mode};
  $('dancePrompt').hidden=false;$('resMain').hidden=true;
  show('res');
}
function commitResult(danceBonus){
  const r=pendingResult;if(!r)return;
  const total=r.score+danceBonus,bkey='zr-best-'+r.mode+(r.mode==='zone'?Z:'');
  let best=null,nb=false;
  try{best=localStorage.getItem(bkey);best=best==null?null:+best;if(best==null||total>best){localStorage.setItem(bkey,total);nb=best!=null}}catch(e){}
  const e={n:r.n,z:r.zlabel,score:total,t:raceT};board.push(e);board.sort((a,b)=>b.score-a.score||a.t-b.t);
  const rk=board.indexOf(e)+1,top=board.length>1&&rk===1,row=(x,i)=>`<li${x===e?' class="me"':''}><span>${i+1}</span><b>${esc(x.n)}</b><em>${x.z}</em><i>${x.score}</i></li>`;
  $('rbest').textContent=(danceBonus>0?('Dance bonus '+danceBonus+'. '):'')+'Total score '+total+'.'+(nb?' New best for this mode!':top?' New session best!':'');
  $('stats').innerHTML+=`<div><b>${danceBonus}</b><span>Dance bonus</span></div><div><b>${total}</b><span>Total score</span></div>`;
  $('lb').innerHTML=board.slice(0,5).map(row).join('')+(rk>5?row(e,rk-1):'');
  shareText=`${r.shareBase}, score ${r.score}${danceBonus?(' + '+danceBonus+' dance bonus = '+total):''}. #ZoneRunner`;
  if(nb||top)burst();
  $('dancePrompt').hidden=true;$('resMain').hidden=false;
  pendingResult=null;
}
