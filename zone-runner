<script>
const cv=document.getElementById('c'),ctx=cv.getContext('2d');
const PAL=[['#22e6ff','#7dff6b'],['#ffe14d','#ff4d6d'],['#ff2fd1','#ff8a3d']];
const ZN=[{n:'Warm-up',lo:114,hi:133,t:'about 2 taps/s'},{n:'Tempo',lo:152,hi:171,t:'4–7 taps/s'},{n:'Sprint',lo:171,hi:200,t:'8+ taps/s'}];
const VMAX=16,CH=1.35,PZ=.35,MAXHR=190,FONT="'Big Shoulders Display',Impact,'Arial Narrow',sans-serif";
let RACE=400;
let W,H,DPR,hz,F,bg;
let v=0,dist=0,camX=0,lane=0,phase=0,kick=0,shake=0,flash=0,hits=0,t=0,cad=0;
let S='start',Z=1,sel=-1,cd=3,lastCd=4,raceT=0,inZ=0,below=0,above=0,hr=72,hrSum=0,hrPeak=72,taps=0,stride=0,stumble=0;
let react=null,mt=2,goAt=0,goT=0,fsN=0,shareText='',board=[],conf=[];
let mode='zone',jumpT=-1,cleared=0,hurdleHit=0,jogHit=0,pRect={x:-999,y:-999,w:0,h:0};
const JUMPD=.6,JUMPH=.9;
let coins=0,boostT=0;
const BOOST_DUR=1.6,BOOST_MULT=1.6;
let reactScore=0,reactCount=0,reactMiss=0,reactTargetActive=false,reactTargetAt=0,reactTargetLane=0,nextTargetAt=0;
const REACT_LEN=20,REACT_WINDOW=1.3;
let danceT=0,dancePoints=0,danceCooldownUntil=0,pendingResult=null;
const DANCE_LEN=15;
let labOpen=false;
let lastDbg={x:0,y:0,z:0,t:9.8,move:'-',dir:'-',action:'-',cd:'ready'};
let obs=[],nextSpawn=6,tapT=[];
const lines=[];for(let i=0;i<40;i++)lines.push({a:Math.random()*6.283,r:Math.random()});
const zone=()=>Z+1;

function resize(){
  DPR=Math.min(devicePixelRatio||1,2);
  W=cv.clientWidth;H=cv.clientHeight;
  cv.width=W*DPR;cv.height=H*DPR;cf.width=W;cf.height=H;
  hz=H*.42;F=Math.min(H*.42,W*.5);
  buildBg();
}
function buildBg(){
  bg=document.createElement('canvas');bg.width=W;bg.height=H;
  const g=bg.getContext('2d');
  const gr=g.createLinearGradient(0,0,0,hz);
  [[0,'#12062e'],[.35,'#4a1266'],[.65,'#c72e7c'],[.87,'#ff6a4d'],[1,'#ffb24a']].forEach(s=>gr.addColorStop(s[0],s[1]));
  g.fillStyle=gr;g.fillRect(0,0,W,hz);
  g.fillStyle='#0d0420';g.fillRect(0,hz,W,H-hz);
  g.fillStyle='#fff';
  for(let i=0;i<50;i++){g.globalAlpha=Math.random()*.7;g.fillRect(Math.random()*W,Math.random()*hz*.5,1.5,1.5)}
  g.globalAlpha=1;
  const r=Math.min(W*.3,H*.17),s=document.createElement('canvas');s.width=s.height=r*2;
  const q=s.getContext('2d'),sg=q.createLinearGradient(0,0,0,r*2);
  sg.addColorStop(0,'#ffe066');sg.addColorStop(1,'#ff2f9a');
  q.fillStyle=sg;q.beginPath();q.arc(r,r,r,0,7);q.fill();
  q.globalCompositeOperation='destination-out';
  for(let i=0;i<6;i++)q.fillRect(0,r*1.05+i*r*.16,r*2,2+i*r*.025);
  g.drawImage(s,W/2-r,hz-r*1.35);
  g.fillStyle='#1a0838';
  for(let x=0;x<W;){const w=18+Math.random()*34,h=r*(.1+Math.random()*.7);g.fillRect(x,hz-h,w,h);x+=w+2}
}

/* ---------- audio ---------- */
let AC,NB,foot=0;
function initAudio(){
  try{
    if(!AC){AC=new(window.AudioContext||window.webkitAudioContext)();
      NB=AC.createBuffer(1,AC.sampleRate*.3|0,AC.sampleRate);
      const d=NB.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1}
    if(AC.state==='suspended')AC.resume();
  }catch(e){}
}
function noise(freq,q,type,dur,vol){
  if(!AC)return;const t0=AC.currentTime,s=AC.createBufferSource(),f=AC.createBiquadFilter(),g=AC.createGain();
  s.buffer=NB;f.type=type;f.frequency.value=freq;f.Q.value=q;
  g.gain.setValueAtTime(vol,t0);g.gain.exponentialRampToValueAtTime(.001,t0+dur);
  s.connect(f);f.connect(g);g.connect(AC.destination);s.start(t0);s.stop(t0+dur);
}
function thump(f0,f1,dur,vol,type){
  if(!AC)return;const t0=AC.currentTime,o=AC.createOscillator(),g=AC.createGain();
  o.type=type||'sine';o.frequency.setValueAtTime(f0,t0);o.frequency.exponentialRampToValueAtTime(f1,t0+dur);
  g.gain.setValueAtTime(vol,t0);g.gain.exponentialRampToValueAtTime(.001,t0+dur);
  o.connect(g);g.connect(AC.destination);o.start(t0);o.stop(t0+dur);
}
function stepSound(){foot^=1;noise((foot?1500:1100)*(.9+Math.random()*.2),.9,'bandpass',.08,.5);thump(foot?120:100,45,.09,.5)}

/* ---------- universal motion engine: BODY MOVEMENT -> SENSOR SPIKE -> THRESHOLD -> ACTION -> COOLDOWN ---------- */
const Motion={
  avail:false,granted:false,
  raw:{x:0,y:0,z:0,t:9.8},base:{x:0,y:0,z:0,t:9.8},
  calibSamples:null,cooldownUntil:0,
  settings:Object.assign({enabled:false,debug:false,sensitivity:1,stepTh:7,jumpTh:15,customTh:2,cooldown:500,stepAxis:'x',customAxis:'z',calibrated:false},
    (()=>{try{return JSON.parse(localStorage.getItem('zr-motion')||'{}')}catch(e){return{}}})()),
  save(){try{localStorage.setItem('zr-motion',JSON.stringify(this.settings))}catch(e){}},
  start(cb){
    const begin=()=>{
      if(!('DeviceMotionEvent' in window)){cb(false,'Motion sensors are not available on this device or browser. Tap, click, keyboard and swipe controls still work.');return}
      window.addEventListener('devicemotion',e=>Motion.onEvent(e));
      this.granted=true;this.avail=true;cb(true,'Motion sensors are live. Try the Motion Lab, or calibrate in Settings.');
    };
    if(typeof DeviceMotionEvent!=='undefined'&&typeof DeviceMotionEvent.requestPermission==='function'){
      DeviceMotionEvent.requestPermission().then(r=>{if(r==='granted')begin();else cb(false,'Motion access was not granted. Tap, click, keyboard and swipe controls still work.')})
        .catch(()=>cb(false,'Could not request motion access. Tap, click, keyboard and swipe controls still work.'));
    }else begin();
  },
  onEvent(e){
    const a=e.accelerationIncludingGravity||e.acceleration;
    if(!a||a.x==null)return;
    const k=.25;
    this.raw.x+=(a.x-this.raw.x)*k;this.raw.y+=(a.y-this.raw.y)*k;this.raw.z+=(a.z-this.raw.z)*k;
    this.raw.t=Math.sqrt(this.raw.x**2+this.raw.y**2+this.raw.z**2);
    if(this.calibSamples)this.calibSamples.push({x:this.raw.x,y:this.raw.y,z:this.raw.z,t:this.raw.t});
    if(labOpen)Lab.feed(this.raw);
    if(this.settings.enabled&&!this.calibSamples)this.detect();
  },
  pending:null,   // {t0, pj, ps, pc, pm}: peaks seen so far while a gesture is being armed
  ARM_MS:110,     // hold this long before deciding, so a spike that's still rising isn't misread as a smaller gesture
  detect(){
    const now=performance.now();
    if(now<this.cooldownUntil){lastDbg.cd='cooling';lastDbg.x=this.raw.x;lastDbg.y=this.raw.y;lastDbg.z=this.raw.z;lastDbg.t=this.raw.t;return}
    lastDbg.cd='ready';
    const s=this.settings,dx=this.raw.x-this.base.x,dy=this.raw.y-this.base.y,dz=this.raw.z-this.base.z,dt_=this.raw.t-this.base.t;
    const sv={x:dx,y:dy,z:dz}[s.stepAxis],cv={x:dx,y:dy,z:dz}[s.customAxis],mag=Math.sqrt(dx*dx+dy*dy+dz*dz);
    lastDbg.x=this.raw.x;lastDbg.y=this.raw.y;lastDbg.z=this.raw.z;lastDbg.t=this.raw.t;
    const jTh=s.jumpTh/s.sensitivity,sTh=s.stepTh/s.sensitivity,cTh=s.customTh/s.sensitivity;
    const p=this.pending;
    if(!p){
      // nothing building yet: only start arming once some signal clears a low fraction of its own threshold
      if(dt_>jTh*.3||Math.abs(sv)>sTh*.3||Math.abs(cv)>cTh*.3)this.pending={t0:now,pj:dt_,ps:sv,pc:cv,pm:mag};
      return;
    }
    p.pj=Math.max(p.pj,dt_);
    if(Math.abs(sv)>Math.abs(p.ps))p.ps=sv;
    if(Math.abs(cv)>Math.abs(p.pc))p.pc=cv;
    p.pm=Math.max(p.pm,mag);
    if(now-p.t0<this.ARM_MS)return;   // keep watching this gesture a little longer before deciding
    this.pending=null;
    if(p.pj>jTh)this.fire('JUMP',null,'TOTAL');
    else if(Math.abs(p.ps)>sTh)this.fire('LANE',p.ps>0?1:-1,s.stepAxis.toUpperCase());
    else if(Math.abs(p.pc)>cTh)this.fire('CUSTOM',null,s.customAxis.toUpperCase());
    else if(p.pm>Math.max(sTh,cTh,jTh)*.9)this.fire('BEAT',null,'MAG');
  },
  fire(action,dir,src){
    this.cooldownUntil=performance.now()+this.settings.cooldown;
    lastDbg.move=action;lastDbg.dir=dir>0?'RIGHT':dir<0?'LEFT':src;lastDbg.action=action;
    onMotionAction(action,dir);
  }
};
const Lab={
  mm:{x:[0,0],y:[0,0],z:[0,0],t:[9.8,9.8]},hist:[],
  reset(){this.mm={x:[0,0],y:[0,0],z:[0,0],t:[9.8,9.8]};this.hist=[]},
  feed(r){
    ['x','y','z','t'].forEach(k=>{this.mm[k][0]=Math.min(this.mm[k][0],r[k]);this.mm[k][1]=Math.max(this.mm[k][1],r[k])});
    this.hist.push({x:r.x,y:r.y,z:r.z,t:r.t});if(this.hist.length>120)this.hist.shift();
    const g=id=>document.getElementById(id);
    g('labX').textContent=r.x.toFixed(2);g('labY').textContent=r.y.toFixed(2);g('labZ').textContent=r.z.toFixed(2);g('labT').textContent=r.t.toFixed(2);
    g('labXmax').textContent=this.mm.x[1].toFixed(2);g('labXmin').textContent=this.mm.x[0].toFixed(2);
    g('labYmax').textContent=this.mm.y[1].toFixed(2);g('labYmin').textContent=this.mm.y[0].toFixed(2);
    g('labZmax').textContent=this.mm.z[1].toFixed(2);g('labZmin').textContent=this.mm.z[0].toFixed(2);
    g('labTmax').textContent=this.mm.t[1].toFixed(2);g('labTmin').textContent=this.mm.t[0].toFixed(2);
    this.draw();
  },
  draw(){
    const cv2=document.getElementById('labGraph');if(!cv2)return;
    if(cv2.width!==cv2.clientWidth||cv2.height!==cv2.clientHeight){cv2.width=cv2.clientWidth;cv2.height=cv2.clientHeight}
    const g=cv2.getContext('2d'),W2=cv2.width,H2=cv2.height;g.clearRect(0,0,W2,H2);
    const cols={x:'#ff6a6a',y:'#7dff6b',z:'#22e6ff'};
    ['x','y','z'].forEach(k=>{
      g.strokeStyle=cols[k];g.lineWidth=2;g.beginPath();
      this.hist.forEach((p,i)=>{const px=i/119*W2,py=H2/2-p[k]*(H2/24);i?g.lineTo(px,py):g.moveTo(px,py)});
      g.stroke();
    });
  }
};

/* ---------- input ---------- */
function jump(){
  if(S!=='race'||mode!=='hurdle'||jumpT>=0)return;
  initAudio();jumpT=0;noise(1200,.6,'highpass',.12,.5);thump(300,700,.14,.4,'sine');
}
function tap(){
  initAudio();const n=performance.now();
  if(S==='marks'||(S==='set'&&n<goAt))return falseStart('You moved before the gun.');
  if(S==='set')goGun();
  if(S!=='race')return;
  if(react==null){react=(n-goT)/1000;if(react<.1)return falseStart('Reaction '+react.toFixed(3)+' s is under 0.100 s.')}
  if(mode==='reaction')return reactionHit('tap');
  taps++;
  if(mode!=='coin'&&v<VMAX)v+=2.2*(1-v/VMAX)+.2;
  kick=1;stepSound();tapT.push(performance.now());
}
const go=d=>{if(S!=='race')return;lane=Math.max(-1,Math.min(1,lane+d))};
function boost(){
  const now=performance.now();
  if(mode!=='sprint'||S!=='race'||boostT>0)return;
  boostT=BOOST_DUR;noise(2200,.5,'highpass',.3,.5);thump(400,900,.3,.5,'sawtooth');
}
function reactionHit(src){
  if(mode!=='reaction'||S!=='race'||!reactTargetActive)return;
  const rt=(performance.now()-reactTargetAt)/1000;reactTargetActive=false;
  reactScore+=Math.max(10,Math.round(1000-rt*700));reactCount++;
  nextTargetAt=t+.6+Math.random()*1.2;
  try{navigator.vibrate(30)}catch(e){}
  noise(1800,.7,'highpass',.08,.4);
}
function danceBeat(src){
  const now=performance.now();
  if(S!=='dance'||now<danceCooldownUntil)return;
  danceCooldownUntil=now+280;
  dancePoints+=8+Math.floor(Math.random()*8);
  const p=document.getElementById('dancePts');if(p)p.textContent=dancePoints;
  const m=document.getElementById('danceMove');if(m)m.textContent='Nice move! ('+src+')';
  try{navigator.vibrate(40)}catch(e){}
  noise(1200+Math.random()*600,.6,'bandpass',.08,.4);
}
function onMotionAction(action,dir){
  if(!Motion.settings.enabled)return;
  if(S==='dance'){danceBeat('motion');return}
  if(S!=='race')return;
  if(mode==='reaction'){reactionHit('motion');return}
  if(action==='JUMP'){jump();return}
  if(action==='LANE'){go(dir);return}
  if(action==='CUSTOM'||action==='BEAT'){
    if(mode==='sprint')boost();
    else if(mode==='zone'||mode==='coin')tap();
  }
}
const P=new Map();
cv.addEventListener('pointerdown',e=>{
  e.preventDefault();P.set(e.pointerId,{x:e.clientX,y:e.clientY});try{cv.setPointerCapture(e.pointerId)}catch(_){}
  if(S==='dance'){danceBeat('tap');return}
  if(mode==='hurdle'&&S==='race'&&e.clientX>=pRect.x&&e.clientX<=pRect.x+pRect.w&&e.clientY>=pRect.y&&e.clientY<=pRect.y+pRect.h)jump();
  else tap();
});
cv.addEventListener('pointermove',e=>{
  const p=P.get(e.pointerId);if(!p)return;
  const dx=e.clientX-p.x,dy=e.clientY-p.y;
  if(Math.abs(dx)>36&&Math.abs(dx)>Math.abs(dy)*1.2){go(dx>0?1:-1);p.x=e.clientX;p.y=e.clientY}
});
['pointerup','pointercancel'].forEach(n=>cv.addEventListener(n,e=>P.delete(e.pointerId)));
addEventListener('keydown',e=>{
  if(e.repeat)return;
  if(S==='dance'){danceBeat('key');return}
  if(S!=='race'&&S!=='marks'&&S!=='set')return;const k=e.key;
  if(k==='ArrowLeft'||k==='a'||k==='A')go(-1);
  else if(k==='ArrowRight'||k==='d'||k==='D')go(1);
  else if(k===' '||k==='w'||k==='W'){tap();e.preventDefault()}
  else if(k==='ArrowUp'){if(mode==='hurdle')jump();else tap();e.preventDefault()}
  else if(k==='b'||k==='B'){if(mode==='sprint')boost()}
});
addEventListener('resize',resize);

/* ---------- world ---------- */
function spawn(){
  const z=zone();
  if(mode==='hurdle'){spawnHurdle(z);return}
  if(mode==='coin'){spawnCoin(z);return}
  const two=Math.random()<.35+z*.08,free=Math.floor(Math.random()*3)-1;
  const use=two?[-1,0,1].filter(l=>l!==free):[Math.floor(Math.random()*3)-1];
  for(const l of use){
    const j=Math.random()<.4+Math.min(.3,z*.05);
    obs.push({x:l,z:85,jog:j,js:j?2.5+Math.random()*3:0,ph:Math.random()*6,col:Math.random()<.5?0:1});
  }
  nextSpawn=dist+Math.max(9,20-z*1.8)+Math.random()*6;
}
function spawnHurdle(z){
  const lanes=[-1,0,1],jogLane=Math.random()<.55+Math.min(.25,z*.04)?lanes[Math.floor(Math.random()*3)]:null;
  for(const l of lanes){
    if(l===jogLane){const j=2.2+Math.random()*2.6;obs.push({x:l,z:85,jog:true,js:j,ph:Math.random()*6,col:Math.random()<.5?0:1})}
    else if(Math.random()<.7)obs.push({x:l,z:85,hurdle:true,js:0});
  }
  nextSpawn=dist+Math.max(8,17-z*1.5)+Math.random()*5;
}
function spawnCoin(z){
  const lanes=[-1,0,1],blockLane=Math.random()<.5?lanes[Math.floor(Math.random()*3)]:null;
  for(const l of lanes){
    if(l===blockLane){
      const j=Math.random()<.5;
      obs.push(j?{x:l,z:85,jog:true,js:2+Math.random()*2,ph:Math.random()*6,col:Math.random()<.5?0:1}:{x:l,z:85,js:0});
    }else if(Math.random()<.85)obs.push({x:l,z:85,coin:true,js:0,spin:Math.random()*6});
  }
  nextSpawn=dist+Math.max(7,14-z)+Math.random()*4;
}
function update(dt){
  t+=dt;
  v=Math.max(0,v-(.28*v+.35)*dt);if(v<.1)v=0;   // inertia: exponential + friction coast
  if(S==='start'||S==='check')v=6;
  if(mode==='coin'&&S==='race')v=7+Math.min(5,dist/150);
  if(boostT>0)boostT=Math.max(0,boostT-dt);
  dist+=v*dt*(boostT>0?BOOST_MULT:1);
  if(S==='marks'){mt-=dt;if(mt<=0){S='set';goAt=performance.now()+1200+Math.random()*1400;thump(520,520,.12,.3,'square')}}
  if(S==='set'&&performance.now()>=goAt)goGun();
  if(S==='marks'||S==='set'||S==='race'||S==='done'){const tg=70+120*Math.min(1,v/VMAX);hr+=(tg-hr)*Math.min(1,dt/(tg>hr?3:12))}
  if(S==='race'){
    raceT+=dt;
    hrSum+=hr*dt;hrPeak=Math.max(hrPeak,hr);
    const q=ZN[Z];if(hr<q.lo)below+=dt;else if(hr>q.hi)above+=dt;else inZ+=dt;
    if(mode==='reaction'){
      if(!reactTargetActive&&t>=nextTargetAt){reactTargetActive=true;reactTargetAt=performance.now();reactTargetLane=[-1,0,1][Math.floor(Math.random()*3)];noise(1000,.8,'bandpass',.08,.4)}
      if(reactTargetActive&&(performance.now()-reactTargetAt)/1000>REACT_WINDOW){reactTargetActive=false;reactMiss++;nextTargetAt=t+.6+Math.random()*1.2}
      if(raceT>=REACT_LEN)finish();
    }else if(dist>=RACE)finish();
  }
  camX+=(lane-camX)*Math.min(1,dt*9);
  const vn=v/VMAX;
  if(v>0){phase+=dt*(2+v*.75);stride+=dt*Math.PI*(.8+v*.35)}
  if(jumpT>=0){jumpT+=dt;if(jumpT>=JUMPD)jumpT=-1}
  kick=Math.max(0,kick-dt*7);stumble=Math.max(0,stumble-dt*2);shake=Math.max(0,shake-dt*3);flash=Math.max(0,flash-dt*2.5);
  if(S==='race'&&mode!=='reaction'&&dist>=nextSpawn&&dist+85<RACE-5)spawn();
  for(const o of obs){
    o.z+=(o.js-v)*dt;
    if(o.coin){
      if(!o.hit&&o.z<PZ+.5&&o.z>PZ-.5&&Math.abs(o.x-camX)<.5){o.hit=1;coins++;noise(1600,.6,'bandpass',.08,.5);thump(900,1400,.08,.4,'sine')}
      continue;
    }
    if(!o.hit&&o.z<PZ+.5&&o.z>PZ-.5&&Math.abs(o.x-camX)<.6){
      const jumping=jumpT>=0&&jumpT<JUMPD;
      if(o.hurdle&&jumping){o.hit=1;cleared++;noise(1800,.7,'bandpass',.1,.4)}
      else{
        o.hit=1;hits++;if(o.hurdle)hurdleHit++;else jogHit++;stumble=1;v*=.3;shake=1;flash=1;
        try{navigator.vibrate(150)}catch(e){}
        noise(500,.7,'lowpass',.3,.9);thump(160,40,.25,.7,'square');
      }
    }
  }
  obs=obs.filter(o=>!o.hit&&o.z>-.5&&o.z<120);
  for(const l of lines){l.r+=dt*(.4+vn*1.6);if(l.r>1){l.r=Math.random()*.15;l.a=Math.random()*6.283}}
  if(S==='dance'){
    danceT+=dt;const left=DANCE_LEN-danceT,te=document.getElementById('danceTimer');
    if(te)te.textContent=Math.max(0,Math.ceil(left));
    if(left<=0){commitResult(dancePoints);show('res')}
  }
}

/* ---------- drawing ---------- */
function hurdleObs(x,y,s){
  const w=.9*s,h=.62*s,by=y-h;
  ctx.strokeStyle='#ffb24a';ctx.shadowColor='#ffb24a';ctx.shadowBlur=8;ctx.lineWidth=.07*s;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(x-w/2,y);ctx.lineTo(x-w/2,by);ctx.moveTo(x+w/2,y);ctx.lineTo(x+w/2,by);ctx.stroke();
  ctx.shadowBlur=0;
  for(let i=0;i<4;i++){ctx.fillStyle=i&1?'#ff2f2f':'#fff';ctx.fillRect(x-w/2,by+i*(h*.14),w,h*.14)}
}
function coinObs(o,x,y,s){
  const r=.3*s,sp=Math.cos(t*4+o.spin);
  ctx.save();ctx.translate(x,y-.9*s);ctx.scale(Math.max(.15,Math.abs(sp)),1);
  ctx.fillStyle='#ffe066';ctx.shadowColor='#ffe066';ctx.shadowBlur=14;
  ctx.beginPath();ctx.arc(0,0,r,0,7);ctx.fill();
  ctx.restore();ctx.shadowBlur=0;
}
function cone(x,y,s){
  const w=.6*s,h=.95*s;
  ctx.fillStyle='#ff6a1a';ctx.beginPath();
  ctx.moveTo(x-w*.14,y-h);ctx.lineTo(x+w*.14,y-h);ctx.lineTo(x+w*.42,y-h*.08);ctx.lineTo(x-w*.42,y-h*.08);ctx.fill();
  ctx.fillStyle='#f4f4f4';ctx.fillRect(x-w*.26,y-h*.6,w*.52,h*.14);
  ctx.fillStyle='#ff3d00';ctx.fillRect(x-w*.55,y-h*.1,w*1.1,h*.1);
}
function jogger(o,x,y,s){
  const c=['#ff2fd1','#22e6ff'][o.col],sw=Math.sin(o.p!=null?o.p:t*9+o.ph),hip=y-.9*s;
  ctx.strokeStyle=c;ctx.fillStyle=c;ctx.shadowColor=c;ctx.shadowBlur=8;ctx.lineCap='round';
  ctx.lineWidth=.15*s;ctx.beginPath();
  ctx.moveTo(x,hip);ctx.lineTo(x+sw*.22*s,y-(sw>0?.08:0)*s);
  ctx.moveTo(x,hip);ctx.lineTo(x-sw*.22*s,y-(sw<0?.08:0)*s);ctx.stroke();
  ctx.lineWidth=.3*s;ctx.beginPath();ctx.moveTo(x,hip);ctx.lineTo(x,y-1.42*s);ctx.stroke();
  ctx.lineWidth=.1*s;ctx.beginPath();
  ctx.moveTo(x,y-1.35*s);ctx.lineTo(x-sw*.2*s,y-s);
  ctx.moveTo(x,y-1.35*s);ctx.lineTo(x+sw*.2*s,y-s);ctx.stroke();
  ctx.shadowBlur=0;
  const im=o.img,iw=im&&im.naturalWidth;
  if(iw){const m=Math.min(iw,im.naturalHeight);ctx.save();ctx.beginPath();ctx.arc(x,y-1.62*s,.2*s,0,7);ctx.clip();ctx.drawImage(im,(iw-m)/2,(im.naturalHeight-m)/2,m,m,x-.2*s,y-1.82*s,.4*s,.4*s);ctx.restore()}
  else{ctx.beginPath();ctx.arc(x,y-1.62*s,.13*s,0,7);ctx.fill()}
}
const HI=document.querySelector('#hud .av');
// The player: chosen character sprite (back view) with a procedural run cycle, or a neon runner wearing the uploaded photo.
function runner(x,y,s){
  const c=CHR[ch],a=Math.min(1,v/3),sn=Math.sin(stride),lf=[Math.max(0,sn),Math.max(0,-sn)];
  ctx.fillStyle='rgba(0,0,0,.4)';ctx.beginPath();ctx.ellipse(x,y,.55*s,.1*s,0,0,7);ctx.fill();
  ctx.save();
  const jp=jumpT>=0&&jumpT<JUMPD?Math.sin(Math.PI*jumpT/JUMPD)*JUMPH*s:0;
  ctx.translate(x,y-Math.abs(sn)*.06*s*a+kick*.05*s-jp);                                    // stride bounce + tap dip + jump
  ctx.rotate(sn*.05*a+(lane-camX)*.28+Math.sin(stumble*9)*stumble*.3);                  // step roll, lane lean, hit stumble
  if(cust)jogger({col:0,ph:0,p:stride,img:HI},0,0,s);
  else if(c.im.naturalWidth){
    const im=c.im,W0=im.naturalWidth,H0=im.naturalHeight,h=1.8*s,k=h/H0,w=W0*k,hp=c.hip*H0,sx=c.sp*W0,ST=6;
    for(let sy=0;sy<H0;sy+=ST){                                                          // draw in strips: flutter everywhere, alternate leg lift below the hip
      const f=sy/H0,fl=Math.sin(t*7-f*6)*.03*h*f*f*(.3+.7*a),dy=-h+sy*k,dh=ST*k+1;
      if(sy<hp)ctx.drawImage(im,0,sy,W0,ST,-w/2+fl,dy,w,dh);
      else{const g=Math.pow((sy-hp)/(H0-hp),1.6);
        for(let i=0;i<2;i++){const x0=i?sx-8:0,x1=i?W0:sx+8;
          ctx.drawImage(im,x0,sy,x1-x0,ST,-w/2+x0*k+fl,dy-lf[i]*a*g*.12*h,(x1-x0)*k,dh)}}
    }
  }
  ctx.restore();
}
// Start-screen turntable: front, side, back and mirrored-side views crossfade (with foreshortening) to fake a 360° spin.
function turn(c,x,y,h,ang){
  const V=[c.imf,c.ims,c.im,c.ims],q=((ang/(Math.PI/2))%4+4)%4,i=q|0,f=q-i,e=f*f*(3-2*f),sc=h/460;
  [[i,1-e,Math.cos(f*Math.PI/2)],[(i+1)%4,e,Math.sin(f*Math.PI/2)]].forEach(([k,al,sx])=>{
    const im=V[k];if(!im.naturalWidth||al<.02)return;
    ctx.save();ctx.globalAlpha=al;ctx.translate(x,y);if(k===3)ctx.scale(-1,1);
    const w=im.naturalWidth*sc*Math.max(.3,sx),ih=im.naturalHeight*sc;ctx.drawImage(im,-w/2,-ih,w,ih);ctx.restore();
  });
}
function draw(){
  const pal=PAL[(zone()-1)%4],vn=v/VMAX;
  ctx.setTransform(DPR,0,0,DPR,0,0);
  ctx.fillStyle='#0d0420';ctx.fillRect(0,0,W,H);
  ctx.save();
  const bx=(Math.random()-.5)*shake*14,by=(Math.random()-.5)*shake*14;
  const bob=Math.sin(phase*2)*H*.007*vn-kick*H*.008;            // camera bob + stride kick
  ctx.translate(W/2+bx,H/2+by+bob);
  ctx.rotate((camX-lane)*.03+Math.sin(phase)*.006*vn);
  ctx.scale(1.05,1.05);ctx.translate(-W/2,-H/2);
  ctx.drawImage(bg,0,0);
  const cx=W/2,cam=camX+Math.sin(phase)*.04*vn;
  // road + ground, row by row
  for(let y=Math.ceil(hz)+1;y<H*1.05;y+=3){
